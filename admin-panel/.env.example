# Copy this file to .env and fill it in. Both Supabase values are safe in a
# browser. Never put the R2 secret key or the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The public address of the R2 bucket, with no trailing slash.
VITE_MEDIA_BASE_URL=https://video.yourdomain.com
